{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mesh-egress values",
  "type": "object",
  "required": ["namespace", "egress"],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {
        "useWaypoint": { "type": "boolean" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "host", "port", "protocol"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              },
              "host": {
                "type": "string",
                "pattern": "^([a-z0-9-]+\\.)+[a-z0-9-]+$"
              },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "protocol": { "type": "string", "enum": ["TLS", "TCP", "HTTPS", "HTTP"] }
            }
          }
        }
      }
    }
  }
}
